{
  "info": {
    "_postman_id": "brewlite-collection-v2",
    "name": "BrewLite - Cashless Coffee API Collection",
    "description": "Bộ kịch bản Test & Demo tự động đầy đủ cho hệ thống BrewLite (Task 1 -> Task 10 + RBAC + KDS + Admin).\nHoạt động ngay cả khi chưa chọn Environment nhờ Collection Variables tích hợp sẵn.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001" },
    { "key": "customer_token", "value": "" },
    { "key": "barista_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "sample_product_id", "value": "1" },
    { "key": "order_id", "value": "" },
    { "key": "cancel_order_id", "value": "" },
    { "key": "order_amount", "value": "0" },
    { "key": "order_idempotency_key", "value": "" },
    { "key": "payment_idempotency_key", "value": "" },
    { "key": "loyalty_before", "value": "0" },
    { "key": "created_barista_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication & Profile (JWT + Loyalty)",
      "item": [
        {
          "name": "1.0 Register Customer (Đăng ký tài khoản mới)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Đăng ký tài khoản thành công (201)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(jsonData.email).to.not.be.undefined;",
                  "    pm.expect(jsonData.role).to.eql('CUSTOMER');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"khach_{{$timestamp}}@brewlite.vn\",\n  \"password\": \"123456\",\n  \"fullName\": \"Trần Thị B\",\n  \"phone\": \"0912345678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.1 Login Customer (Khách hàng)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var token = jsonData.accessToken || jsonData.token;",
                  "pm.test('Đăng nhập Khách hàng thành công (200) & lưu token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('customer_token', token);",
                  "    pm.environment.set('customer_token', token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@brewlite.vn\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Get Customer Profile & Loyalty Points (GET /auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Lấy hồ sơ & điểm Loyalty ban đầu thành công', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.email).to.eql('user@brewlite.vn');",
                  "    pm.expect(jsonData.loyaltyPoints).to.be.a('number');",
                  "    pm.collectionVariables.set('loyalty_before', jsonData.loyaltyPoints);",
                  "    pm.environment.set('loyalty_before', jsonData.loyaltyPoints);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "1.3 Login Barista (Nhân viên pha chế)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var token = jsonData.accessToken || jsonData.token;",
                  "pm.test('Đăng nhập Barista thành công (200) & lưu barista_token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('barista_token', token);",
                  "    pm.environment.set('barista_token', token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"barista@brewlite.vn\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Login Admin (Quản lý cửa hàng)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var token = jsonData.accessToken || jsonData.token;",
                  "pm.test('Đăng nhập Admin thành công (200) & lưu admin_token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('admin_token', token);",
                  "    pm.environment.set('admin_token', token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@brewlite.vn\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products & Ingredient Stock (RBAC)",
      "item": [
        {
          "name": "2.1 Lấy danh sách món (Menu công khai)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Trả về danh sách món kèm stock tính từ nguyên liệu', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData).to.be.an('array').and.not.empty;",
                  "    pm.collectionVariables.set('sample_product_id', jsonData[0].id);",
                  "    pm.environment.set('sample_product_id', jsonData[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "2.2 Xem chi tiết 1 sản phẩm",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Trả về chi tiết sản phẩm hợp lệ', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.id).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/{{sample_product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{sample_product_id}}"]
            }
          }
        },
        {
          "name": "2.3 [RBAC] Khách hàng xem kho nguyên liệu -> Bị chặn 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chặn đúng nghiệp vụ: Khách hàng bị 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/products/ingredients/stock",
              "host": ["{{base_url}}"],
              "path": ["products", "ingredients", "stock"]
            }
          }
        },
        {
          "name": "2.4 [RBAC] Barista xem kho nguyên liệu thô (g/ml)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Barista lấy danh sách nguyên liệu thô thành công (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData).to.be.an('array').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{barista_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/products/ingredients/stock",
              "host": ["{{base_url}}"],
              "path": ["products", "ingredients", "stock"]
            }
          }
        },
        {
          "name": "2.5 [RBAC] Barista/Admin cập nhật tồn kho nguyên liệu #1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Cập nhật tồn kho nguyên liệu thành công (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{barista_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 5000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/products/ingredients/1/stock",
              "host": ["{{base_url}}"],
              "path": ["products", "ingredients", "1", "stock"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Orders (Tạo đơn, Idempotency & Lịch sử)",
      "item": [
        {
          "name": "3.1 Tạo đơn hàng mới (Áp voucher GIAM10 + Idempotency-Key)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var ordKey = 'ord-idemp-' + Date.now();",
                  "pm.collectionVariables.set('order_idempotency_key', ordKey);",
                  "pm.environment.set('order_idempotency_key', ordKey);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Tạo đơn thành công (201, PENDING) & áp Voucher GIAM10', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(jsonData.id).to.not.be.undefined;",
                  "    pm.expect(jsonData.status).to.eql('PENDING');",
                  "    pm.expect(jsonData.discount).to.be.above(0);",
                  "    pm.collectionVariables.set('order_id', jsonData.id);",
                  "    pm.environment.set('order_id', jsonData.id);",
                  "    pm.collectionVariables.set('order_amount', jsonData.total);",
                  "    pm.environment.set('order_amount', jsonData.total);",
                  "    var payKey = 'pay-idemp-' + Date.now();",
                  "    pm.collectionVariables.set('payment_idempotency_key', payKey);",
                  "    pm.environment.set('payment_idempotency_key', payKey);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Idempotency-Key", "value": "{{order_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"qty\": 2,\n      \"size\": \"L\",\n      \"toppings\": [\"Trân châu đen\"]\n    }\n  ],\n  \"voucherCode\": \"GIAM10\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "3.2 [Idempotent] Gửi lại Tạo đơn cùng Idempotency-Key -> Trả cùng 1 Order ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var prevId = Number(pm.collectionVariables.get('order_id') || pm.environment.get('order_id'));",
                  "pm.test('Idempotent Order: Không tạo đơn mới, trả về đúng ID cũ', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(jsonData.id).to.eql(prevId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Idempotency-Key", "value": "{{order_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"qty\": 2,\n      \"size\": \"L\",\n      \"toppings\": [\"Trân châu đen\"]\n    }\n  ],\n  \"voucherCode\": \"GIAM10\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "3.3 Xem chi tiết đơn hàng vừa tạo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Lấy chi tiết đơn hàng thành công (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.items).to.be.an('array').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}"]
            }
          }
        },
        {
          "name": "3.4 Xem lịch sử đơn của khách (GET /orders/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Lấy lịch sử đơn hàng của tôi thành công (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/orders/me",
              "host": ["{{base_url}}"],
              "path": ["orders", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Payments (Cashless, Fail/Retry, Idempotent & Loyalty)",
      "item": [
        {
          "name": "4.1 Giả lập thanh toán thất bại (PAYMENT_FAILED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Đơn chuyển sang PAYMENT_FAILED và không cộng điểm', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(jsonData.status).to.eql('PAYMENT_FAILED');",
                  "    pm.expect(jsonData.earnedPoints).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{order_id}},\n  \"method\": \"CARD\",\n  \"simulateFailure\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/payments",
              "host": ["{{base_url}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "4.2 Thử lại thanh toán thành công (Kèm Idempotency-Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Thanh toán thành công (PAID) & cộng điểm Loyalty', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(jsonData.status).to.eql('PAID');",
                  "    pm.expect(jsonData.earnedPoints).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Idempotency-Key", "value": "{{payment_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{order_id}},\n  \"method\": \"WALLET\",\n  \"amount\": {{order_amount}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/payments",
              "host": ["{{base_url}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "4.3 [Idempotent] Thanh toán lặp lại cùng Idempotency-Key (Chống trừ tiền 2 lần)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Idempotent Payment: Trả kết quả cũ, không trừ tiền lần 2', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(jsonData.status).to.eql('PAID');",
                  "    pm.expect(jsonData.message).to.include('Idempotent');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Idempotency-Key", "value": "{{payment_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{order_id}},\n  \"method\": \"WALLET\",\n  \"amount\": {{order_amount}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/payments",
              "host": ["{{base_url}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "4.4 Kiểm tra điểm Loyalty đã tăng (GET /auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var before = Number(pm.collectionVariables.get('loyalty_before') || pm.environment.get('loyalty_before') || 0);",
                  "pm.test('Điểm Loyalty đã tăng sau khi đơn chuyển PAID', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.loyaltyPoints).to.be.above(before);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Barista KDS (State Machine & Hủy đơn hoàn kho)",
      "item": [
        {
          "name": "5.1 Barista xem hàng đợi pha chế",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
